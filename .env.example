# Copy to .env and restart the Vite dev server after any change.

# Deployed Spring Boot API (used by login, signup, logout, password reset).
VITE_API_BASE_URL=https://codingplatform-tdt0.onrender.com/api/v1

# Local backend instead of Render:
# VITE_API_BASE_URL=http://localhost:8081/api/v1

# Other features (problems, companies, ...) still use fixtures when true.
VITE_USE_MOCK=false

# Auth hits the real API unless this is true.
VITE_USE_MOCK_AUTH=false

# Optional. Defaults to {API origin}/oauth2/authorization/google
# VITE_OAUTH_GOOGLE_URL=https://codingplatform-tdt0.onrender.com/oauth2/authorization/google

# Optional. Cookie name if the refresh token is readable (not HttpOnly).
# VITE_REFRESH_TOKEN_COOKIE=refreshToken
